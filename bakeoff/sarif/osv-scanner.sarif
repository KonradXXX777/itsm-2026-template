                "security-severity": "8.9"
              },
              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-97689: urllib3: HTTPResponse.stream()/read_chunked() buffers an unbounded chunk-size line into memory",
                "text": "CVE-2026-97689: urllib3: HTTPResponse.stream()/read_chunked() buffers an unbounded chunk-size line into memory"
              }
